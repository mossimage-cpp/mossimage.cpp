// Workaround for ROCm clang's MSVC-mode <cmath> header-order conflict (MSVC 14.51+ declares a few comparison
// functions constexpr, which clang treats as __host__ __device__; the HIP wrapper then declares them __device__ only
// and the declarations collide). Including clang's forward-declares header before the real <cmath> is the ordering
// clang itself uses in newer releases. This header shadows <cmath> for the HIP kernel sources only.
//
// Do not apply it to ordinary C++ translation units: the forward-declares header is a HIP/CUDA header.
#if defined(__HIP__) && !defined(__HIPCC_RTC__)
#include <__clang_cuda_math_forward_declares.h>
#endif
#include_next <cmath>
